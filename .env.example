NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Required for online payments (seller subaccounts, checkout redirect, verify).
# Use a test key (sk_test_...) in development. In production also configure the
# Paystack dashboard webhook to POST /api/payments/paystack/webhook; local dev
# relies on verify-on-return when the buyer lands back on the tracking page.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_APP_URL=
# Transactional email (order updates, team invites, abandoned-cart, broadcasts).
# Defaults to Gmail: leave HOST/PORT blank for smtp.gmail.com:465 (implicit TLS;
# use 587 for STARTTLS). EMAIL_SMTP_PASSWORD must be a Google *App Password*
# (myaccount.google.com → Security → 2-Step Verification → App passwords) —
# a normal account password will be rejected with EAUTH.
# Gmail rewrites From to the authenticated mailbox unless EMAIL_FROM_EMAIL is a
# verified "Send mail as" alias. Free Gmail caps sending at ~500 recipients/day;
# move to a dedicated provider before broadcasts exceed that.
# The email channel degrades to "not_configured" (no throw) when USER/PASSWORD
# are unset, in which case EMAIL_WEBHOOK_URL is used if present.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=
# Legacy fallback transport, only used when EMAIL_SMTP_* is unset.
EMAIL_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=
PUSH_WEBHOOK_URL=
# Consent-based order-update SMS (Techieszon). Optional — the SMS channel
# degrades to "not_configured" (no throw) when any of these are unset.
TECHIESZON_SMS_API_KEY=
TECHIESZON_SMS_API_URL=
TECHIESZON_SMS_SENDER_ID=
INTERNAL_JOB_SECRET=
CRON_SECRET=
API_KEY_PEPPER=
# COURIER_<PROVIDER>_WEBHOOK_SECRET=
# Extra LAN origins allowed to reach the dev server, comma-separated.
# ALLOWED_DEV_ORIGINS=
# Google sign-in: set to true once the Supabase Google provider is configured
# (supabase/config.toml locally; Auth → Providers in the dashboard for prod).
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET must be exported for `supabase start`.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# SMS OTP login (Twilio). Required for `supabase start` to send real SMS
# codes locally. Also configure the equivalent Phone provider in the
# Supabase Cloud dashboard (Authentication → Providers → Phone) for
# production — Cloud does not read supabase/config.toml.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGE_SERVICE_SID=
# Custom SMTP for Supabase Auth emails (login OTP codes, etc.). Required for
# `supabase start` to send real email locally instead of the rate-limited
# default. Also configure the same values in the Supabase Cloud dashboard
# (Authentication → Emails → SMTP Settings) for production — Cloud does not
# read supabase/config.toml.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
# Social publishing (Accounts tab activates per provider when set).
# SOCIAL_TOKEN_KEY seals stored OAuth tokens — any long random secret.
# SOCIAL_TOKEN_KEY=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
SUPABASE_SEND_SMS_HOOK_SECRET=
