NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Required for online payments (seller subaccounts, checkout redirect, verify).
# Use a test key (sk_test_...) in development. In production also configure the
# Paystack dashboard webhook to POST /api/payments/paystack/webhook; local dev
# relies on verify-on-return when the buyer lands back on the tracking page.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_APP_URL=
# Transactional email (order updates, team invites, abandoned-cart, broadcasts).
# Defaults to Gmail: leave HOST/PORT blank for smtp.gmail.com:465 (implicit TLS;
# use 587 for STARTTLS). EMAIL_SMTP_PASSWORD must be a Google *App Password*
# (myaccount.google.com → Security → 2-Step Verification → App passwords) —
# a normal account password will be rejected with EAUTH.
# Gmail rewrites From to the authenticated mailbox unless EMAIL_FROM_EMAIL is a
# verified "Send mail as" alias. Free Gmail caps sending at ~500 recipients/day;
# move to a dedicated provider before broadcasts exceed that.
# The email channel degrades to "not_configured" (no throw) when USER/PASSWORD
# are unset, in which case EMAIL_WEBHOOK_URL is used if present.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=
# Legacy fallback transport, only used when EMAIL_SMTP_* is unset.
EMAIL_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=
PUSH_WEBHOOK_URL=
# Consent-based order-update SMS (Techieszon). Optional — the SMS channel
# degrades to "not_configured" (no throw) when any of these are unset.
TECHIESZON_SMS_API_KEY=
TECHIESZON_SMS_API_URL=
TECHIESZON_SMS_SENDER_ID=
# Inbound STOP/START replies: POST /api/sms/inbound/techieszon. PROVISIONAL —
# Techieszon's inbound/MO webhook contract is unconfirmed; the route verifies an
# HMAC-SHA256 of the raw body in x-techieszon-signature with this secret.
# Unset = the route answers 503 not_configured (STOPs are not being received).
TECHIESZON_SMS_INBOUND_SECRET=
# Local/staging only: shared secret for POST /api/sms/inbound/sandbox (header
# x-sms-sandbox-secret). Ignored when VERCEL_ENV=production.
SMS_INBOUND_SANDBOX_SECRET=
# Signs the sd_attr campaign-attribution cookie (any long random secret).
# Required in production: attribution decides who earns creator commission,
# so an unsigned cookie would let anyone claim credit for a link.
# Signs the sd_attr campaign-attribution cookie. Commission depends on it, so
# an unsigned cookie would let anyone mint attribution to a link they never
# posted. Any long random secret.
ATTRIBUTION_SECRET=
# Bearer token pg_cron presents to /api/internal/** workers. The SAME value must
# also be in Supabase Vault as `internal_job_secret` — see
# docs/runbooks/background-jobs.md. They have drifted before; when they do,
# every worker 401s silently.
INTERNAL_JOB_SECRET=
# Keys the HMAC that fingerprints a payout destination, so a retry cannot mint a
# second Paystack recipient. src/lib/payouts/destinations.ts THROWS if this and
# INTERNAL_JOB_SECRET are both unset. Any long random secret.
PAYOUT_FINGERPRINT_SECRET=
# Unused. Vercel cron was abandoned for pg_cron (the Hobby plan allows 2 daily
# jobs and we need 13). Kept only so nobody re-adds it expecting it to work —
# see docs/runbooks/background-jobs.md.
# CRON_SECRET=
API_KEY_PEPPER=
# COURIER_<PROVIDER>_WEBHOOK_SECRET=
# Courier adapters (src/lib/couriers/registry.ts). Each is also gated by the
# courier_booking:<id> feature flag; env alone never turns a courier on.
# Sandbox: deterministic fake courier for local/staging. NEVER true in prod.
# COURIER_SANDBOX_ENABLED=false
# COURIER_SANDBOX_WEBHOOK_SECRET=
# Yango Delivery: awaiting partner API access. The adapter stays
# not_configured until its mapping is verified in code, even with these set.
# COURIER_YANGO_API_BASE_URL=
# COURIER_YANGO_API_KEY=
# COURIER_YANGO_WEBHOOK_SECRET=
# Seller KYC (src/lib/kyc/registry.ts), also gated by the kyc_auto flag.
# KYC_PROVIDER picks the vendor new checks start with; unset = not_configured
# (manual operator approval only). Vendor undecided: Smile ID / Youverify /
# Dojah / Prembly — each will add its own KYC_<VENDOR>_* vars here.
# KYC_PROVIDER=
# Sandbox vendor for local/staging. NEVER enable in production.
# KYC_SANDBOX_ENABLED=false
# KYC_SANDBOX_WEBHOOK_SECRET=
# passed | failed — what polling a sandbox check answers; unset stays pending.
# KYC_SANDBOX_AUTO_RESULT=
# Extra LAN origins allowed to reach the dev server, comma-separated.
# ALLOWED_DEV_ORIGINS=
# Google sign-in: set to true once the Supabase Google provider is configured
# (supabase/config.toml locally; Auth → Providers in the dashboard for prod).
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET must be exported for `supabase start`.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# SMS OTP login (Twilio). Required for `supabase start` to send real SMS
# codes locally. Also configure the equivalent Phone provider in the
# Supabase Cloud dashboard (Authentication → Providers → Phone) for
# production — Cloud does not read supabase/config.toml.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGE_SERVICE_SID=
# Custom SMTP for Supabase Auth emails (login OTP codes, etc.). Required for
# `supabase start` to send real email locally instead of the rate-limited
# default. Also configure the same values in the Supabase Cloud dashboard
# (Authentication → Emails → SMTP Settings) for production — Cloud does not
# read supabase/config.toml.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
# Social publishing (Accounts tab activates per provider when set).
# SOCIAL_TOKEN_KEY seals stored OAuth tokens — any long random secret.
# SOCIAL_TOKEN_KEY=
# NEXT_PUBLIC_AUTH_APPLE_ENABLED=
# NEXT_PUBLIC_AUTH_FACEBOOK_ENABLED=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
SUPABASE_SEND_SMS_HOOK_SECRET=
# Buyer accounts (flag buyer_accounts). Seals saved buyer payment authorisations
# (buyer_payment_methods.provider_token_sealed) with AES-256-GCM. Deliberately a
# DIFFERENT secret from SOCIAL_TOKEN_KEY. Unset = saving payment methods is off.
# BUYER_PAYMENT_TOKEN_KEY=
# Error tracking (Sentry). Leave blank locally, in tests and in CI: with no DSN
# the SDK is never initialised and nothing is sent anywhere. SENTRY_DSN is read
# by the server/edge runtimes; NEXT_PUBLIC_SENTRY_DSN is inlined into the
# browser bundle at build time (usually the same value). Events are scrubbed of
# emails, phone numbers, auth headers and Paystack/Meta keys before sending —
# see src/lib/observability/scrub.ts.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional overrides. Environment defaults to VERCEL_ENV; trace sampling to 0.1
# (money routes are always 1.0 regardless).
# SENTRY_ENVIRONMENT=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=
# NEXT_PUBLIC_SENTRY_RELEASE=
# Source map upload at build time. Only happens when SENTRY_AUTH_TOKEN is set
# (Vercel production builds); maps are deleted from the output after upload.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# Anthropic API key for AI features (Snap-to-list drafts, the WhatsApp agent,
# caption suggestions). Server-only. Unset = every AI feature reports
# not_configured and stays off; nothing throws. Spend is recorded per call in
# ai_runs and capped per seller per month (src/lib/ai/budget.ts).
ANTHROPIC_API_KEY=
# Show machine-drafted Pidgin/Twi strings (marked needsReview in
# packages/core/src/i18n/messages) instead of falling back to English. Only for
# translators on a preview deployment; leave unset in production.
# I18N_SHOW_DRAFTS=true
# WhatsApp Cloud API (Meta). In production the three secrets below
# (WHATSAPP_ACCESS_TOKEN, WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN) live in
# Supabase Vault as whatsapp_access_token / whatsapp_app_secret /
# whatsapp_verify_token (migration 202609250261); Vault wins, and these env
# vars are the local-development fallback. The phone number id stays in env.
# Sending also needs the wa_outbound feature flag;
# the agent needs wa_agent. Unset = WhatsApp falls back to WHATSAPP_WEBHOOK_URL
# (legacy relay) or dead-letters as not_configured, exactly as before.
# WHATSAPP_PHONE_NUMBER_ID: the shared SnapDuka number's id in Meta's dashboard.
# WHATSAPP_ACCESS_TOKEN: a System User token with whatsapp_business_messaging.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Verifies X-Hub-Signature-256 on POST /api/whatsapp/webhook (the Meta app's
# App Secret). Without it every inbound webhook is refused.
WHATSAPP_APP_SECRET=
# Any random string; paste the same value into Meta's webhook "Verify token".
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_DISPLAY_NUMBER: the shared number buyers message (E.164, e.g.
# +233300000000). Storefronts link to it with a SHOP-<code> prefix when the
# wa_agent flag is on for that seller. Unset = no assistant link.
WHATSAPP_DISPLAY_NUMBER=
# Stock financing (ADR-0014; src/lib/financing/partner.ts), also gated by the
# stock_financing flag and financing_policies.enabled per market. Which partner
# funds a market is financing_policies.partner, not an env var. No lending
# partner is contracted yet: each will add its own FINANCING_<PARTNER>_* vars.
# Sandbox partner for local/staging. NEVER enable in production: it "funds"
# advances with money no partner sent.
# FINANCING_SANDBOX_ENABLED=false
# FINANCING_SANDBOX_WEBHOOK_SECRET=
# funded (default) | pending | declined
# FINANCING_SANDBOX_AUTO_DECISION=
# Buy now, pay later at checkout (src/lib/bnpl/registry.ts), also gated by the
# bnpl flag. BNPL_PROVIDER picks the partner; unset = not_configured (never
# offered). No partner is contracted yet.
# BNPL_PROVIDER=
# Sandbox partner for local/staging. NEVER enable in production: its signed
# "approved" webhook marks orders paid.
# BNPL_SANDBOX_ENABLED=false
# BNPL_SANDBOX_WEBHOOK_SECRET=
# Promoted listings click links are signed with ATTRIBUTION_SECRET under a
# separate key domain (src/lib/ads/click-token.ts); no new secret is needed.
