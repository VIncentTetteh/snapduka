NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Required for online payments (seller subaccounts, checkout redirect, verify).
# Use a test key (sk_test_...) in development. In production also configure the
# Paystack dashboard webhook to POST /api/payments/paystack/webhook; local dev
# relies on verify-on-return when the buyer lands back on the tracking page.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_APP_URL=
EMAIL_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=
PUSH_WEBHOOK_URL=
INTERNAL_JOB_SECRET=
CRON_SECRET=
API_KEY_PEPPER=
# COURIER_<PROVIDER>_WEBHOOK_SECRET=
# Extra LAN origins allowed to reach the dev server, comma-separated.
# ALLOWED_DEV_ORIGINS=
# Google sign-in: set to true once the Supabase Google provider is configured
# (supabase/config.toml locally; Auth → Providers in the dashboard for prod).
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET must be exported for `supabase start`.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# Social publishing (Accounts tab activates per provider when set).
# SOCIAL_TOKEN_KEY seals stored OAuth tokens — any long random secret.
# SOCIAL_TOKEN_KEY=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
